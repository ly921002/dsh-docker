# Normalize line endings: force LF in the repository so the shell scripts and
# Dockerfile keep working when the repo is cloned on Linux.
* text=auto eol=lf

# Explicitly text
*.sh text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.conf text eol=lf

# Binary-ish / never touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zst binary
