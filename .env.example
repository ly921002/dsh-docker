# Copy to .env and edit. Everything here is optional -- the compose file has
# working defaults.

# Host port published for the container (compose binds it to 127.0.0.1).
DSH_PORT=3080

# Container timezone.
TZ=Asia/Shanghai

# Optional memory cap. Office->PDF on Linux runs through the LibreOfficeKit
# WASM engine, which is RAM-hungry; 2g is a safe floor.
DSH_MEM_LIMIT=2g

# --- Remote access -----------------------------------------------------------
# The root browsers actually reach DSH through. Drives the printed/opened URL,
# DSH_WEB_URL and the runtime Web GUI URL. Must be http/https with a trailing
# slash; may carry a mount prefix such as https://app.example/ui/.
# DSH_PUBLIC_URL=https://dsh.example.com/

# Extra authority the /api browser-trust fence accepts, whitespace separated
# (repeatable flag). Required whenever the browser-visible Host is not the
# container's own bind address -- otherwise every API call answers 403.
# DSH_TRUSTED_HOST=dsh.example.com

# --- Optional native TLS inside the container ---------------------------------
# Paths resolve against DSH_WORKSPACE (/workspace in the image). Read once at
# startup, never re-read, no HTTP fallback, no renewal.
# DSH_TLS_CERT=/workspace/tls/fullchain.pem
# DSH_TLS_KEY=/workspace/tls/privkey.pem
