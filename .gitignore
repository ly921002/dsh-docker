# Byte-compiled / optimized / unused files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Node
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-store/

# Test / coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.tox/

# Editors / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Local runtime state produced by `docker compose up`
/data/
/workspace/*
!/workspace/.gitkeep

# Local environment (never commit real credentials)
.env
.env.local
